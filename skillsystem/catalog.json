  "workflows": {
    "kdp-research": {
      "description": "Evidence-led niche research and opportunity analysis; external signals are subject to network and provider access.",
      "steps": [
        {
          "skill": "ui-ux-pro-max",
          "reason": "Optional dashboard/chart accessibility guidance; not a research data source."
        },
        {
          "skill": "xlsx",
          "reason": "Organize supplied research data; LibreOffice is needed for formula recalculation."
        },
        {
          "skill": "discernment-nudge",
          "reason": "Review interpretation and uncertainties before decisions."
        }
      ],
      "notes": [
        "Use the existing Flask KDP engine separately; skills do not mine Amazon themselves.",
        "Preserve ACTUAL/ESTIMATED/SIMULATED/MOCK/UNAVAILABLE source labels; never treat autocomplete as volume."
      ]
    },
    "book-writing": {
      "description": "Plan, draft, review, and package a professional book with human editorial control.",
      "steps": [
        {
          "skill": "doc-coauthoring",
          "reason": "Gather audience, goal, outline, and review criteria."
        },
        {
          "skill": "discernment-nudge",
          "reason": "Review claims, assumptions and risks."
        },
        {
          "skill": "docx",
          "reason": "When a Word deliverable is requested, use documented editing workflow."
        },
        {
          "skill": "canvas-design",
          "reason": "Optional cover concept; render and review separately."
        }
      ],
      "notes": [
        "Fact-check cited claims and ensure permissions; skills do not provide publishing or professional editorial certification.",
        "Formatting and visual QA require appropriate document/rendering dependencies."
      ]
    },
    "document-production": {
      "description": "Select the format-specific skill, then validate and visually inspect outputs.",
      "steps": [
        {
          "skill": "doc-coauthoring",
          "reason": "Develop structure and gather requirements."
        },
        {
          "skill": "docx",
          "reason": "Use only for Word deliverables."
        },
        {
          "skill": "pdf",
          "reason": "Use for PDF inspection and form workflows."
        },
        {
          "skill": "xlsx",
          "reason": "Use for spreadsheet deliverables."
        },
        {
          "skill": "pptx",
          "reason": "Use for PowerPoint deliverables."
        },
        {
          "skill": "theme-factory",
          "reason": "Optional presentation styling."
        }
      ],
      "notes": [
        "These are alternatives by requested format, not instructions to run every skill.",
        "Office renderers and reliable offline schema validation are not available in the audited environment."
      ]
    },
    "premium-motion": {
      "description": "Develop motion direction, scripted visuals and delivery with explicit rendering and quality gates.",
      "steps": [
        {
          "skill": "brand",
          "reason": "Establish visual identity when a brand brief exists."
        },
        {
          "skill": "algorithmic-art",
          "reason": "Explore generative visual direction; p5 and browser rendering are untested."
        },
        {
          "skill": "design-system",
          "reason": "Consult local visual/slide search and token guidance."
        },
        {
          "skill": "yt-script",
          "reason": "Optional narration and hook guidance; scoring is heuristic."
        },
        {
          "skill": "yt-edit",
          "reason": "Optional transcript-based edit decision list; does not edit video."
        },
        {
          "skill": "slack-gif-creator",
          "reason": "For small Slack GIFs only, not a premium video renderer."
        }
      ],
      "notes": [
        "The skills are guidance and small helpers, not a video-generation or rendering engine.",
        "Use repository video/Blender tooling separately when compatible; FFmpeg, Blender, browser and visual QA must be checked before promising output."
      ]
    }
  }
