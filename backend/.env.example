# Optional — all integrations work without these keys (features degrade gracefully with clear labels).

# DataForSEO — for actual monthly search volume + reverse ASIN (ranked keywords)
# Get keys at https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_API_KEY=

# Pangolinfo — for blue-ocean niche discovery via filter_niches MCP
# Free 200 calls at https://tool.pangolinfo.com
PANGOLINFO_API_KEY=
PANGOLINFO_API_TOKEN=

# Optional proxy to avoid Amazon throttling at scale
PROXY_URL=

# Marketplace default (us, uk, ca, au, de, in)
MARKETPLACE=us

# Rate limits (seconds between requests per source)
AUTOCOMPLETE_RATE_LIMIT=0.8
PRODUCT_SCRAPE_RATE_LIMIT=1.2
SEARCH_PROBE_RATE_LIMIT=1.0
DATAFORSEO_RATE_LIMIT=0.3

PORT=5000
FLASK_DEBUG=0
